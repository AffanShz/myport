---
import Layout from '../layouts/Layout.astro';
import DecryptedText from '../components/DecryptedText.astro';
import BorderGlow from '../components/BorderGlow.jsx';
---
<Layout>
<nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 flex items-center justify-center md:justify-between px-6 md:px-8 py-3 max-w-5xl mx-auto rounded-full mt-6 w-fit bg-surface/60 backdrop-blur-3xl border border-outline-variant/10 inner-glow-top-left scale-95 transition-all duration-500 -translate-y-[150%] opacity-0">
  <a class="font-display-lg text-body-lg font-bold tracking-tighter text-primary mr-0 md:mr-12 transition-opacity uppercase text-center" href="#"><DecryptedText text="AFFAN SHAHZADA" animateOn="hover" speed={40} maxIterations={8} className="text-primary" encryptedClassName="text-primary/40" /></a>
  <div class="hidden md:flex items-center gap-6 font-label-caps text-label-caps uppercase">
    <a class="text-on-surface-variant hover:text-primary transition-colors px-3 py-1" href="#about"><DecryptedText text="ABOUT" animateOn="hover" className="text-on-surface-variant" encryptedClassName="text-primary/40" /></a>
    <a class="text-on-surface-variant hover:text-primary transition-colors px-3 py-1" href="#stack"><DecryptedText text="STACK" animateOn="hover" className="text-on-surface-variant" encryptedClassName="text-primary/40" /></a>
    <a class="text-on-surface-variant hover:text-primary transition-colors px-3 py-1" href="#work"><DecryptedText text="WORK" animateOn="hover" className="text-on-surface-variant" encryptedClassName="text-primary/40" /></a>
    <a class="text-on-surface-variant hover:text-primary transition-colors px-3 py-1" href="#contact"><DecryptedText text="CONTACT" animateOn="hover" className="text-on-surface-variant" encryptedClassName="text-primary/40" /></a>
  </div>
  <a href="https://github.com/AffanShz" target="_blank" rel="noopener noreferrer" class="ml-12 font-label-caps text-label-caps uppercase px-6 py-2 rounded-full border border-outline-variant hover:bg-primary hover:text-surface transition-colors hidden md:block"><DecryptedText text="GITHUB" animateOn="hover" className="text-inherit" encryptedClassName="text-primary/40" /></a>
</nav>
<main class="flex-grow">
<!-- Parallax Background -->
<div class="fixed inset-0 w-full h-[150vh] -z-50 overflow-hidden pointer-events-none bg-background" id="parallax-bg">
  <div class="parallax-layer absolute inset-x-0 -top-[10%] h-[120%] bg-cover bg-top opacity-20 mix-blend-screen grayscale" data-speed="0.1" style="background-image: url('https://images.unsplash.com/photo-1542224566-6e85f2e6772f?q=60&w=800&auto=format')"></div>
  <div class="parallax-layer absolute inset-x-0 -top-[5%] h-[120%] bg-gradient-to-b from-transparent via-background/60 to-background opacity-70" data-speed="0.2"></div>
  <div class="parallax-layer parallax-mask-top absolute inset-x-0 top-[15%] h-[120%] bg-cover bg-center opacity-25 mix-blend-luminosity grayscale" data-speed="0.35" style="background-image: url('https://images.unsplash.com/photo-1605469237651-40989f6fc05b?q=60&w=800&auto=format')"></div>
  <div class="parallax-layer absolute inset-x-0 top-[25%] h-[120%] bg-gradient-to-t from-background via-background/90 to-transparent" data-speed="0.5"></div>
  <div class="parallax-layer parallax-mask-top-30 absolute inset-x-0 top-[40%] h-[120%] bg-cover bg-bottom opacity-40 mix-blend-luminosity grayscale" data-speed="0.7" style="background-image: url('https://images.unsplash.com/photo-1516656209536-1507f320b92e?q=60&w=800&auto=format')"></div>
  <div class="parallax-layer absolute inset-x-0 top-[60%] h-[120%] bg-gradient-to-t from-background via-background to-transparent opacity-100" data-speed="0.9"></div>
</div>
<!-- Hero Section -->
<section class="relative min-h-screen flex flex-col justify-center items-center overflow-hidden px-4 sm:px-6 md:px-grid-margin pt-32 w-full max-w-full">
  <div class="z-10 relative flex flex-col items-center justify-center gap-stack-lg w-full max-w-7xl mx-auto text-center">
    <div class="flex flex-col items-center uppercase gap-2 md:gap-0 w-full">
      <h1 class="font-display-xl text-[38px] sm:text-5xl md:text-display-xl text-primary tracking-tighter leading-tight md:leading-[0.85] text-left w-full md:w-auto self-start md:self-center py-1 overflow-visible"><span class="block"><DecryptedText text="AFFAN" animateOn="view" sequential={true} revealDirection="start" speed={30} className="text-primary" encryptedClassName="text-primary/30" /></span></h1>
      <h1 class="font-display-xl text-[38px] sm:text-5xl md:text-display-xl text-primary tracking-tighter leading-tight md:leading-[0.85] text-right w-full md:w-auto self-end md:self-center mr-0 md:ml-12 lg:ml-24 py-1 overflow-visible"><span class="block"><DecryptedText text="SHAHZADA" animateOn="view" sequential={true} revealDirection="start" speed={40} className="text-primary" encryptedClassName="text-primary/30" /></span></h1>
    </div>
    <div class="flex items-center gap-4 mt-8 border-t border-outline-variant/50 pt-8 w-full max-w-md">
      <span class="w-12 h-[1px] bg-primary/50"></span>
      <p class="font-label-caps text-label-caps text-on-surface-variant uppercase text-left">Passionate Mobile Developer <br/> Flutter &amp; Dart Enthusiast</p>
    </div>
  </div>
</section>
<!-- About Section -->
<section class="py-12 md:py-stack-xl px-4 sm:px-6 md:px-grid-margin relative z-20 bg-background overflow-hidden w-full max-w-full" id="about">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-grid-gutter items-center">
    <div class="col-span-1 md:col-span-5 relative group px-2 sm:px-0">
      <div class="absolute inset-0 md:-inset-4 bg-surface/40 border border-outline-variant/20 inner-glow-top-left transform translate-y-2 md:translate-y-4 -translate-x-2 md:-translate-x-4 z-0 transition-transform duration-500 group-hover:translate-y-2 group-hover:-translate-x-2"></div>
      <img alt="Portrait of Affan Shahzada" class="w-full aspect-[1.49] object-cover filter grayscale contrast-125 border border-outline-variant relative z-10 transition-all duration-700 group-hover:grayscale-0" src="/assets/profile.webp" width="800" height="537" loading="eager" fetchpriority="high" decoding="async" />
      <div class="absolute -bottom-4 right-0 md:-bottom-8 md:-right-8 w-24 h-24 md:w-32 md:h-32 border-r border-b border-primary/40 z-20"></div>
    </div>
    <div class="col-span-1 md:col-span-6 md:col-start-7 flex flex-col gap-stack-lg mt-12 md:mt-0">
      <div class="flex flex-col gap-2">
        <span class="font-label-caps text-label-caps text-primary uppercase tracking-widest">01 // Profile</span>
        <h2 class="font-display-lg text-3xl sm:text-4xl md:text-display-lg text-primary leading-none uppercase">Executive <br/> Summary</h2>
      </div>
      <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed pl-4 md:pl-8 border-l border-outline-variant/40">Informatics Engineering Student (IT-BSc) at Dian Nuswantoro University (Batch 2024) dedicated to building innovative mobile applications. Possesses a deep understanding of modern software architecture and user interface design centered on interactive experiences.</p>
      <a class="font-label-caps text-label-caps text-primary uppercase flex items-center gap-2 group w-fit mt-4" href="#work">
        <span class="border-b border-primary pb-1">View Selected Works</span>
        <span class="material-symbols-outlined transform transition-transform group-hover:translate-x-2">arrow_forward</span>
      </a>
    </div>
  </div>
</section>
<!-- Core Competencies Section -->
<section class="py-12 md:py-stack-xl px-4 sm:px-6 md:px-grid-margin bg-surface-container-lowest relative z-20 overflow-hidden w-full max-w-full" id="stack">
  <div class="max-w-6xl mx-auto flex flex-col gap-stack-xl">
  <span class="font-label-caps text-label-caps text-primary uppercase tracking-widest">02 // Skills</span>
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 md:gap-8 border-b border-outline-variant/30 pb-8">
      <h2 class="font-display-lg text-3xl sm:text-4xl md:text-display-lg text-primary uppercase leading-none text-left w-full md:w-auto">Core<br/>Competencies</h2>
      <p class="font-label-caps text-label-caps text-on-surface-variant uppercase max-w-xs text-left md:text-right w-full md:w-auto">Core Competencies driving technical excellence and elegant solutions.</p>
    </div>
    <div class="flex flex-col w-full">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between py-12 border-b border-outline-variant/20 group hover:bg-surface-bright/5 transition-colors px-4 cursor-crosshair">
        <div class="flex items-center gap-4 md:gap-8 mb-4 md:mb-0 w-full md:w-auto">
          <span class="font-label-caps text-label-caps text-on-surface-variant group-hover:text-primary transition-colors">01</span>
          <h3 class="font-headline-hero text-3xl md:text-headline-hero text-on-surface group-hover:text-primary transition-colors uppercase">Mobile Development</h3>
        </div>
        <div class="flex items-center gap-4 md:gap-12 w-full md:w-auto justify-between md:justify-end">
          <span class="font-label-caps text-label-caps text-on-surface-variant uppercase">Flutter / Dart</span>
          <span class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors text-3xl font-light">phone_iphone</span>
        </div>
      </div>
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between py-12 border-b border-outline-variant/20 group hover:bg-surface-bright/5 transition-colors px-4 cursor-crosshair">
        <div class="flex items-center gap-4 md:gap-8 mb-4 md:mb-0 w-full md:w-auto">
          <span class="font-label-caps text-label-caps text-on-surface-variant group-hover:text-primary transition-colors">02</span>
          <h3 class="font-headline-hero text-3xl md:text-headline-hero text-on-surface group-hover:text-primary transition-colors uppercase">UI/UX Implementation</h3>
        </div>
        <div class="flex items-center gap-4 md:gap-12 w-full md:w-auto justify-between md:justify-end">
          <span class="font-label-caps text-label-caps text-on-surface-variant uppercase">Pixel Perfect / Motion</span>
          <span class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors text-3xl font-light">design_services</span>
        </div>
      </div>
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between py-12 border-b border-outline-variant/20 group hover:bg-surface-bright/5 transition-colors px-4 cursor-crosshair">
        <div class="flex items-center gap-4 md:gap-8 mb-4 md:mb-0 w-full md:w-auto">
          <span class="font-label-caps text-label-caps text-on-surface-variant group-hover:text-primary transition-colors">03</span>
          <h3 class="font-headline-hero text-3xl md:text-headline-hero text-on-surface group-hover:text-primary transition-colors uppercase">Problem Solving</h3>
        </div>
        <div class="flex items-center gap-4 md:gap-12 w-full md:w-auto justify-between md:justify-end">
          <span class="font-label-caps text-label-caps text-on-surface-variant uppercase">Architecture / Logic</span>
          <span class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors text-3xl font-light">extension</span>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- Projects Section -->
<section class="py-12 md:py-stack-xl px-4 sm:px-6 md:px-grid-margin bg-background relative z-20 overflow-hidden w-full max-w-full" id="work">
  <div class="max-w-7xl mx-auto flex flex-col gap-stack-xl">
    <div class="flex flex-col gap-4 text-center items-center mb-12">
      <span class="font-label-caps text-label-caps text-primary uppercase tracking-widest">03 // Projects</span>
      <h2 class="font-display-lg text-3xl sm:text-4xl md:text-display-lg text-primary uppercase">Selected Works</h2>
    </div>
    <!-- Project 1 -->
    <BorderGlow client:visible edgeSensitivity={30} glowColor="0 0 100" backgroundColor="#131314" borderRadius={0} glowRadius={40} glowIntensity={1.0} coneSpread={25} animated={true} colors={['#ffffff', '#e5e2e3', '#c4c7c8']} fillOpacity={0} className="w-full">
      <div class="relative group p-4 sm:p-6 md:p-12 flex flex-col lg:flex-row gap-6 md:gap-grid-gutter items-center min-h-[60vh] backdrop-blur-sm">
        <div class="w-full lg:w-5/12 flex flex-col gap-stack-md z-10 order-2 lg:order-1">
          <div class="flex items-center gap-4 mb-4">
            <span class="px-3 py-1 border border-outline-variant/50 rounded-full font-label-caps text-label-caps text-on-surface-variant uppercase">Mobile App</span>
            <span class="font-label-caps text-label-caps text-outline-variant">2026</span>
          </div>
          <h3 class="font-display-lg text-3xl sm:text-4xl md:text-display-lg text-primary uppercase tracking-tight leading-none mb-4">dcc<br/>mobile</h3>
          <p class="font-body-md text-body-md text-on-surface-variant max-w-sm mb-8">A sophisticated mobile application demonstrating core Dart and Flutter paradigms, engineered for high performance and seamless user interaction.</p>
          <a href="https://github.com/AffanShz/Dinus-Career-Center-Mobile" target="_blank" rel="noopener noreferrer" class="w-fit px-6 py-3 md:px-8 md:py-4 rounded-full bg-primary text-surface font-label-caps text-label-caps uppercase hover:bg-surface-bright hover:text-primary border border-transparent hover:border-primary transition-all duration-300">Explore Repository</a>
        </div>
        <div class="w-full lg:w-7/12 relative h-full min-h-[220px] md:min-h-[400px] order-1 lg:order-2 overflow-hidden border border-outline-variant/30">
          <img class="absolute inset-0 w-full h-full object-cover filter grayscale contrast-125 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-1000 ease-out" alt="dcc_mobile app screenshot" src="/assets/dcc.webp" width="1000" height="738" loading="lazy" decoding="async" />
        </div>
      </div>
    </BorderGlow>
    <!-- Project 2 -->
    <BorderGlow client:visible edgeSensitivity={30} glowColor="0 0 100" backgroundColor="#131314" borderRadius={0} glowRadius={40} glowIntensity={1.0} coneSpread={25} animated={true} colors={['#ffffff', '#e5e2e3', '#c4c7c8']} fillOpacity={0} className="w-full mt-12">
      <div class="relative group p-4 sm:p-6 md:p-12 flex flex-col lg:flex-row-reverse gap-6 md:gap-grid-gutter items-center min-h-[60vh] backdrop-blur-sm">
        <div class="w-full lg:w-5/12 flex flex-col gap-stack-md z-10 order-2 lg:order-1 lg:pl-12">
          <div class="flex items-center gap-4 mb-4">
            <span class="px-3 py-1 border border-outline-variant/50 rounded-full font-label-caps text-label-caps text-on-surface-variant uppercase">Agriculture Tech</span>
            <span class="font-label-caps text-label-caps text-outline-variant">2023</span>
          </div>
          <h3 class="font-display-lg text-3xl sm:text-4xl md:text-display-lg text-primary uppercase tracking-tight leading-none mb-4">Petani<br/>Maju</h3>
          <p class="font-body-md text-body-md text-on-surface-variant max-w-sm mb-8">Empowering local agriculture through technology. A robust platform designed to streamline supply chains and provide vital data to farmers.</p>
          <a href="https://github.com/AffanShz/Petani-Maju-V.2" target="_blank" rel="noopener noreferrer" class="w-fit px-6 py-3 md:px-8 md:py-4 rounded-full bg-transparent text-primary font-label-caps text-label-caps uppercase border border-outline-variant hover:bg-primary hover:text-surface transition-all duration-300">View Repository</a>
        </div>
        <div class="w-full lg:w-7/12 relative h-full min-h-[220px] md:min-h-[400px] order-1 lg:order-2 overflow-hidden border border-outline-variant/30">
          <img class="absolute inset-0 w-full h-full object-cover filter grayscale contrast-125 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-1000 ease-out" alt="PetaniMaju app screenshot" src="/assets/petani_maju.webp" width="1000" height="740" loading="lazy" decoding="async" />
        </div>
      </div>
    </BorderGlow>
  </div>
</section>
</main>
<!-- Contact Section -->
<section class="py-12 md:py-stack-xl px-4 sm:px-6 md:px-grid-margin relative z-20 border-t border-outline-variant/20 overflow-hidden w-full max-w-full" id="contact">
  <div class="absolute inset-0 bg-background -z-20"></div>
  <div class="absolute inset-0 -z-10 bg-cover bg-center opacity-10 mix-blend-screen grayscale" style="background-image: url('https://images.unsplash.com/photo-1542224566-6e85f2e6772f?q=60&w=800&auto=format')"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-background/40 via-transparent to-background/70"></div>
  <div class="max-w-7xl mx-auto flex flex-col gap-stack-xl">
    <div class="flex flex-col gap-8">
      <span class="font-label-caps text-label-caps text-primary uppercase tracking-widest">04 // Contact</span>
      <h2 class="font-display-xl text-3xl sm:text-4xl md:text-display-lg text-primary uppercase leading-none tracking-tighter">
        Let's build<br/>something<br/>meaningful
      </h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-12 gap-grid-gutter items-end">
      <div class="md:col-span-6">
        <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed max-w-md">
          Based in Indonesia. Working worldwide. Open for collaborations and new opportunities.
        </p>
      </div>
      <div class="md:col-span-6 flex flex-col gap-6 md:items-end">
        <a class="group flex items-center gap-2 md:gap-4 text-2xl sm:text-3xl md:text-5xl text-primary hover:text-outline-variant transition-all uppercase tracking-tighter font-display-lg" href="mailto:affanshahzada@gmail.com">
          Email
          <span class="material-symbols-outlined text-4xl group-hover:translate-x-2 transition-transform">north_east</span>
        </a>
        <div class="flex flex-wrap gap-8 md:justify-end">
          <a class="font-label-caps text-label-caps text-on-surface-variant hover:text-primary transition-colors uppercase border-b border-transparent hover:border-primary pb-1" href="https://www.linkedin.com/in/affanshahzada/" target="_blank" rel="noopener noreferrer">Linkedin</a>
          <a class="font-label-caps text-label-caps text-on-surface-variant hover:text-primary transition-colors uppercase border-b border-transparent hover:border-primary pb-1" href="https://github.com/AffanShz" target="_blank" rel="noopener noreferrer">Github</a>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- Footer -->
<footer class="w-full px-4 sm:px-6 md:px-grid-margin py-12 md:py-stack-lg border-t border-outline-variant/30 bg-background relative z-30 overflow-hidden">
  <div class="w-full flex justify-center text-center">
    <p class="font-label-caps text-[10px] sm:text-label-caps text-on-surface-variant uppercase tracking-wider sm:tracking-widest">&copy; 2026 AFFAN SHAHZADA. ALL RIGHTS RESERVED.</p>
  </div>
</footer>

<!-- Floating Back to Top -->
<button id="back-to-top" onclick="window.scrollTo({top:0,behavior:'smooth'})" class="fixed bottom-6 right-6 md:bottom-8 md:right-8 z-50 w-12 h-12 rounded-full bg-surface/80 backdrop-blur-md border border-outline-variant/30 flex items-center justify-center text-primary hover:bg-primary hover:text-surface transition-all duration-300 translate-y-16 opacity-0">
  <span class="material-symbols-outlined text-sm">arrow_upward</span>
</button>

<script>
  const nav = document.getElementById('main-nav');
  const backToTop = document.getElementById('back-to-top');
  const about = document.getElementById('about');

  document.addEventListener('scroll', () => {
    const scrolled = window.scrollY;
    const aboutTop = about?.offsetTop ?? window.innerHeight;
    const pastHero = scrolled >= aboutTop - 80;

    // navbar
    if (pastHero) {
      nav?.classList.remove('-translate-y-[150%]', 'opacity-0');
      nav?.classList.add('translate-y-0', 'opacity-100');
    } else {
      nav?.classList.add('-translate-y-[150%]', 'opacity-0');
      nav?.classList.remove('translate-y-0', 'opacity-100');
    }

    // back to top
    if (pastHero) {
      backToTop?.classList.remove('translate-y-16', 'opacity-0');
      backToTop?.classList.add('translate-y-0', 'opacity-100');
    } else {
      backToTop?.classList.add('translate-y-16', 'opacity-0');
      backToTop?.classList.remove('translate-y-0', 'opacity-100');
    }

    // parallax
    document.querySelectorAll('.parallax-layer').forEach(layer => {
      const speed = parseFloat(layer.getAttribute('data-speed') ?? '0');
      /** @type {HTMLElement} */ (layer).style.transform = `translate3d(0, ${-(scrolled * speed)}px, 0)`;
    });
  });
</script>
</Layout>
